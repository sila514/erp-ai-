# Bu dosyayı .env olarak kopyalayıp gerçek değerlerle doldur.
# cp infra/.env.example infra/.env

ENV=development
DEBUG=true

DATABASE_URL=postgresql://erp_user:erp_pass@postgres:5432/erp_db

SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

ML_SERVICE_URL=http://ml_service:8001

# Event-driven mimari (satış oluştuğunda ml_service'e Redis Streams ile bildirilir)
REDIS_URL=redis://redis:6379/0

# AI Copilot icin gerekli - Anthropic Console'dan alinir
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-sonnet-4-6

CORS_ORIGINS=["http://localhost:5173"]
